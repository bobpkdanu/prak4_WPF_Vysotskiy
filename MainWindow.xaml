<Window x:Class="prak4_Vysotskiy.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Data Binding" Height="750" Width="1000"
 MinHeight="580" MinWidth="800" WindowStartupLocation="CenterScreen"
 Background="#F8FAFC" FontFamily="Segoe UI" FontSize="14">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#172554" Padding="20">
            <StackPanel>
                <TextBlock Text="Карточка студента" Foreground="White" FontSize="25" FontWeight="Bold"/>
                <TextBlock Text="Привязка" Foreground="#BFDBFE" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#E2E8F0" Padding="10">
            <TextBlock x:Name="StatusText" Text="Готово" Foreground="#475569"/>
        </Border>
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Background="White" CornerRadius="10" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Поиск по ID:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                    <TextBox x:Name="SearchIdBox" Width="140" Height="32" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="Найти" Width="100" Height="32" Click="Find_Click" Background="#2563EB" Foreground="White"/>
                    <TextBlock Text="Файл: student_ID.json" Foreground="#64748B" VerticalAlignment="Center" Margin="20,0,0,0"/>
                </StackPanel>
            </Border>
            <Grid Grid.Row="1" Margin="0,16,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="White" CornerRadius="10" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Данные студента" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                        <TextBlock Text="ID записи" Foreground="#64748B"/>
                        <TextBlock Text="{Binding Id}" FontSize="20" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,14"/>
                        <TextBlock Text="Фамилия"/>
                        <TextBox Text="{Binding LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,12"/>
                        <TextBlock Text="Имя"/>
                        <TextBox Text="{Binding FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,12"/>
                        <TextBlock Text="Группа"/>
                        <TextBox Text="{Binding Group, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,12"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Оценки" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                        <TextBlock Text="Оценка 1"/>
                        <TextBox Text="{Binding Grade1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,12"/>
                        <TextBlock Text="Оценка 2"/>
                        <TextBox Text="{Binding Grade2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,12"/>
                        <TextBlock Text="Оценка 3"/>
                        <TextBox Text="{Binding Grade3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,12"/>
                        <TextBlock Text="Средний балл" Foreground="#64748B"/>
                        <TextBlock Text="{Binding AverageGrade, StringFormat={}{0:F2}}" FontSize="30" FontWeight="Bold" Foreground="#0F766E" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Новая запись" Width="130" Height="38" Margin="0,0,10,0" Click="New_Click"/>
                <Button Content="Сохранить" Width="130" Height="38" Background="#2563EB" Foreground="White" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
